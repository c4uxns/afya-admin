@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Barra Superior (AppBar) *@
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2 fw-bold">Afya Pedagógico</MudText>
        
        <MudBreadcrumbs Items="_breadcrumbItems" Class="ml-4 d-none d-md-flex" />
        
        <MudSpacer />
        
        <MudTextField T="string" Placeholder="Pesquisar..." Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mr-4 d-none d-sm-flex" Style="max-width: 250px;" />

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.NightsStay)" 
                       Color="Color.Inherit" OnClick="@ToggleTheme" />
        
        <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mx-2">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
        </MudBadge>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-2">
            <MudAvatar Size="Size.Small" Color="Color.Primary">AM</MudAvatar>
            <div class="d-none d-md-block">
                <MudText Typo="Typo.body2" Class="fw-bold" Style="line-height: 1;">Alex Morgan</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">alex.morgan@afya.com.br</MudText>
            </div>
        </MudStack>
    </MudAppBar>

    @* Menu Lateral (Sidebar) *@
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu Class="mt-2">
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Class="fw-bold">Dashboard</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Analytics">Analytics</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
            
            <MudNavLink Icon="@Icons.Material.Filled.Folder">
                Projetos
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-auto">8</MudChip>
            </MudNavLink>
            
            <MudNavLink Icon="@Icons.Material.Filled.AttachMoney">Financeiro</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.BarChart">Relatórios</MudNavLink>

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.overline" Class="px-4 text-muted">ADMINISTRAÇÃO</MudText>

            <MudNavLink Icon="@Icons.Material.Filled.Person">Usuários</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Lock">Permissões</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Extension">
                Integrações
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-auto">Novo</MudChip>
            </MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Settings">Configurações</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Help">Ajuda</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    @* Conteúdo da Página *@
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "#"),
        new BreadcrumbItem("Dashboard", href: null, disabled: true)
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;
}